# Pooled PostgreSQL connection used by the running API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Direct PostgreSQL connection used for controlled Prisma migration commands.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Hosting providers normally supply PORT automatically.
PORT=4000
NODE_ENV=development

# Comma-separated browser origins. Leave empty to preserve permissive demo CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://nexbook-campus.vercel.app

# Configure production secrets in the hosting provider, never in Git.
